# Ordinary local-development Vite proxy target (Backend F5).
# Default matches Backend local F5: http://127.0.0.1:8080
# Do NOT put bearer tokens or other secrets in VITE_* variables.
#
# Product E2E is separate: Playwright sets VITE_DEV_API_PROXY_TARGET to its
# isolated backend (PRODUCT_E2E_BACKEND_PORT default 8000). Do not conflate.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
